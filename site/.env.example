# A fine-grained GitHub token: Contents read and write on Rafewm/github-trending-api-managed (the Hidden and Track
# lists live on its `lists` branch), plus the Starring read and write account permission (star check, Star button).
# Own name because --env-file never overrides a GITHUB_TOKEN already set in the environment.
UNSTARRED_TOKEN=

# Secret you type in the browser before hiding or unhiding a repo. Anyone with it can edit the lists.
HIDE_KEY=
